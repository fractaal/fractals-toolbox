#!/usr/bin/env bash
# Kill detached idle autospawn tmux sessions after an optional grace period.
set -euo pipefail

delay=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --delay)
      if [[ $# -lt 2 || ! "$2" =~ ^[0-9]+$ ]]; then
        printf 'tmux-prune-idle-sessions: --delay requires seconds\n' >&2
        exit 2
      fi
      delay="$2"
      shift 2
      ;;
    *)
      printf 'tmux-prune-idle-sessions: unknown arg: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

if [[ "$delay" -gt 0 ]]; then
  sleep "$delay"
fi

helper="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/tmux-idle-session"
[[ -x "$helper" ]] || exit 0

while IFS= read -r session; do
  [[ -n "$session" ]] || continue
  tmux kill-session -t "=$session" 2>/dev/null || true
done < <("$helper" list 2>/dev/null || true)
