#!/usr/bin/env bash
# Join tmux sessions by direct fuzzy match, or via fzf picker with no args.
set -euo pipefail

bin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
rows_cmd="$bin_dir/tmux-session-rows"

usage() {
  cat >&2 <<'USAGE'
Usage: tjoin [pattern]
       tj    [pattern]
       tjoin-tui [initial-query]
       tjt       [initial-query]
USAGE
}

current_session() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux display-message -p '#{client_session}' 2>/dev/null || true
  fi
}

row_name() {
  local row="$1"
  printf '%s' "${row%%$'\t'*}"
}

row_titles() {
  local row="$1"
  local rest="${row#*$'\t'}"
  [[ "$rest" == "$row" ]] && return 0
  rest="${rest#*$'\t'}"
  [[ "$rest" == "$row" ]] && return 0
  printf '%s' "${rest% | }"
}

pick_session() {
  local query="$*"
  if ! command -v fzf >/dev/null 2>&1; then
    echo "tjoin: fzf is required for the picker." >&2
    return 127
  fi

  local rows selected
  rows="$($rows_cmd 2>/dev/null)" || true
  if [[ -z "$rows" ]]; then
    echo "tjoin: no tmux sessions found." >&2
    return 1
  fi

  local -a fzf_args
  fzf_args=(
    --delimiter=$'\t'
    --with-nth=1,2,3
    --prompt='tjoin> '
    --height=80%
    --layout=reverse
    --border
    --header='enter join highlighted • esc cancel'
  )
  if [[ -n "$query" ]]; then
    fzf_args+=(--query="$query")
  fi

  selected="$(printf '%s\n' "$rows" | fzf "${fzf_args[@]}")" || return $?
  [[ -n "$selected" ]] || return 130
  printf '%s\n' "$selected"
}

switch_to_session() {
  local name="$1"
  local titles="$2"

  echo "Joining $name \"$titles\""
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$name"
  else
    tmux attach -t "$name"
  fi
}

match_session() {
  local query="$*"
  local pattern="${query,,}"
  local current=""
  current="$(current_session)"

  local -a session_matches=() title_matches=() matches=()
  local line name _attached titles lower_name lower_titles
  while IFS=$'\t' read -r name _attached titles; do
    [[ -n "${name:-}" ]] || continue
    lower_name="${name,,}"
    lower_titles="${titles,,}"
    if [[ "$lower_name" == *"$pattern"* ]]; then
      session_matches+=("${name}"$'\t'"${titles}")
    elif [[ "$name" != "$current" && "$lower_titles" == *"$pattern"* ]]; then
      title_matches+=("${name}"$'\t'"${titles}")
    fi
  done < <("$rows_cmd")

  if (( ${#session_matches[@]} > 0 )); then
    matches=("${session_matches[@]}")
  else
    matches=("${title_matches[@]}")
  fi

  if (( ${#matches[@]} == 0 )); then
    echo "tjoin: no session matches '$query'" >&2
    return 1
  fi
  if (( ${#matches[@]} > 1 )); then
    echo "tjoin: '$query' is ambiguous, matches ${#matches[@]} sessions:" >&2
    for line in "${matches[@]}"; do
      name="${line%%$'\t'*}"
      titles="${line#*$'\t'}"
      echo "  $name  ${titles% | }" >&2
    done
    return 1
  fi

  printf '%s\n' "${matches[0]}"
}

main() {
  local invoked="$(basename -- "$0")"
  local row name titles

  case "$invoked" in
    tjoin-tui|tjt)
      row="$(pick_session "$@")" || return $?
      ;;
    tjoin|tj)
      if [[ $# -eq 0 ]]; then
        row="$(pick_session)" || return $?
      else
        row="$(match_session "$@")" || return $?
      fi
      ;;
    *)
      usage
      return 2
      ;;
  esac

  name="$(row_name "$row")"
  titles="$(row_titles "$row")"
  switch_to_session "$name" "$titles"
}

main "$@"
